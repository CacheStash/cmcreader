{
  "name": "zenreader",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "node server.js",
    "web": "npm run build && node server.js",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.zenreader.app",
    "productName": "ZenReader",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    }
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.2.0",
    "express": "^5.2.1",
    "framer-motion": "^12.31.0",
    "jszip": "^3.10.1",
    "node-unrar-js": "2.0.2",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}